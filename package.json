{
  "name": "@mistral-ui/design-system",
  "version": "0.0.0-semantic-release",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrohrodrig/mistral-ui-design-system.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/mistral-ui.umd.cjs",
  "module": "./dist/mistral-ui.js",
  "types": "./dist/mistral-ui.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/mistral-ui.js",
      "require": "./dist/mistral-ui.umd.cjs"
    },
    "./styles.css": "./dist/mistral-ui.css"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.13.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.0",
    "@storybook/addon-a11y": "^9.1.2",
    "@storybook/addon-docs": "^9.1.2",
    "@storybook/addon-onboarding": "^9.1.2",
    "@storybook/addon-vitest": "^9.1.2",
    "@storybook/react-vite": "^9.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.54.2",
    "postcss": "^8.5.6",
    "semantic-release": "^25.0.9",
    "storybook": "^9.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
